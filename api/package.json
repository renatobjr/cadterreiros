{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --module ESNext --target ES2020 --moduleResolution node --outDir dist/",
    "start:dev": "nodemon",
    "start:stg": "nodemon dist/index.js",
    "start:stg:pm2": "npm run build && npm run start:stg",
    "start:prod": "nodemon dist/index.js"
  },
  "nodemonConfig": {
    "watch": [
      "src/**/*"
    ],
    "ext": "ts",
    "exec": "ts-node --files -r tsconfig-paths/register ./src/index.ts"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/generate-password": "^1.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mustache": "^4.2.6",
    "@types/nodemailer": "^6.4.17",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "express": "~5.1.0",
    "generate-password": "^1.7.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "morgan": "~1.9.1",
    "multer": "^2.0.1",
    "mustache": "^4.2.0",
    "nodemailer": "^7.0.5",
    "openai": "^5.3.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.3",
    "class-transformer": "^0.5.1",
    "dayjs": "^1.11.13",
    "node-geocoder": "^4.4.1",
    "nodemon": "^3.1.10",
    "reflect-metadata": "^0.2.2",
    "shared-types": "^1.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
