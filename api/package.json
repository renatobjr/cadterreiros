{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start:dev": "nodemon"
  },
  "nodemonConfig": {
    "watch": [
      "src/**/*"
    ],
    "ext": "ts",
    "exec": "ts-node --files -r tsconfig-paths/register ./src/index.ts"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "express": "~5.1.0",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "mongoose": "^8.14.1",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/node-geocoder": "^4.2.6",
    "node-geocoder": "^4.4.1",
    "nodemon": "^3.1.10",
    "shared-types": "^1.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typerscript": "^0.2.3"
  }
}
