# ---------- obrigatórias ----------
# Conexão do Mongo (o banco é escolhido em MONGO_INITDB_DATABASE).
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_INITDB_DATABASE=cadterreiros_stg

# Assinatura dos JWT de sessão/recuperação. Use um segredo longo e aleatório.
JWT_SECRET=troque-por-um-segredo-forte

# Origens autorizadas a usar o cookie de sessão (lista separada por vírgula).
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Header x-cadterreiros-api exigido pelas rotas públicas (fail-closed).
CADTERREIROS_API_KEY=troque-pela-chave

# Envio de e-mail transacional (Resend).
RESEND_API_KEY=re_troque_pela_chave

# ---------- opcionais (com fallback) ----------
API_PORT=3000
NODE_BASE_URL=/api/v1

# development | production. Em produção ativa cookie Secure, CORS restrito,
# trust proxy e log "combined".
NODE_ENV=development

# Remetente verificado no domínio (fallback interno se ausente).
MAIL_FROM="Cadterreiros <suporte@cciao.org>"

# Só são usadas pelo docker-compose.yml (Mongo com autenticação).
# O sandbox local (container `cadterreiros`) não usa auth.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
